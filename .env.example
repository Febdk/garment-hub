DB_PORT=3306
DB_USER=garment_user
DB_PASS=Password_Aman_MySQL_Anda
DB_NAME=garment_warehouse

# Allowed Origins untuk CORS (Sesuaikan dengan subdomain eformku.id Anda)
ALLOWED_ORIGINS=https://garment.eformku.id,http://garment.eformku.id,http://localhost:3000

